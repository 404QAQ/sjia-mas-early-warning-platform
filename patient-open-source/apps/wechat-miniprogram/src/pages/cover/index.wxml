<view class="page">
  <view class="nav-bar">
    <view class="nav-title">无恙</view>
    <view class="nav-meta">生活助手</view>
  </view>

  <view class="weather-hero">
    <view class="hero-topline"><text>{{today}}</text><text>{{weekday}}</text></view>
    <view class="hero-row">
      <view class="hero-copy">
        <view class="hero-title">{{greeting}}</view>
        <view class="hero-subtitle">给今天留一点从容</view>
      </view>
      <view class="hero-sun" aria-hidden="true"><view class="hero-sun-core"></view></view>
    </view>
    <view class="hero-pills">
      <view class="hero-pill"><view class="pill-label">今日提醒</view><view class="pill-value">{{weather}}</view></view>
      <view class="hero-pill"><view class="pill-label">出行建议</view><view class="pill-value">{{weatherDetail}}</view></view>
      <view class="hero-pill"><view class="pill-label">今日心情</view><view class="pill-value">{{care}}</view></view>
    </view>
  </view>

  <view class="content">
    <view class="section-card weather-index">
      <view class="section-heading"><view class="section-title">生活指数</view><view class="live-badge">今日</view></view>
      <view class="index-grid">
        <view class="index-cell"><view class="index-label">舒适提示</view><view class="index-value">慢一点</view></view>
        <view class="index-cell"><view class="index-label">出行提示</view><view class="index-value">适合散步</view></view>
        <view class="index-cell"><view class="index-label">补水提醒</view><view class="index-value">记得带水</view></view>
        <view class="index-cell"><view class="index-label">穿衣建议</view><view class="index-value">按体感增减</view></view>
      </view>
      <view class="index-list">
        <view class="index-line"><view>空气质量</view><view><text class="index-strong">良</text><text class="index-muted">适合通风</text></view></view>
        <view class="index-line"><view>紫外线</view><view><text class="index-strong">弱</text><text class="index-muted">无需特别防护</text></view></view>
        <view class="index-line"><view>今日建议</view><view><text class="index-strong">保持节奏</text><text class="index-muted">给自己留余地</text></view></view>
      </view>
    </view>

    <view class="tip-card">
      <view class="tip-icon" aria-hidden="true">衣</view>
      <view class="tip-copy"><view class="tip-title">穿衣指数</view><view class="tip-detail">{{weatherDetail}}</view></view>
      <view class="tip-chevron" aria-hidden="true"></view>
    </view>

    <view class="memo-card">
      <view class="memo-heading"><view class="memo-title"><view class="memo-icon" aria-hidden="true">▤</view>家庭备忘录</view><view class="memo-count">今日</view></view>
      <view class="memo-item"><view class="memo-bullet"></view><view class="memo-text">{{care}}</view></view>
      <view class="memo-item"><view class="memo-bullet"></view><view class="memo-text">{{encouragement}}</view></view>
    </view>

    <button class="entry" bindtap="enter" loading="{{opening}}" disabled="{{opening}}">{{error ? '重新连接' : '进入日常记录'}}<view class="entry-arrow" aria-hidden="true"></view></button>
    <view class="entry-note">从今天的一点一滴开始</view>
    <view wx:if="{{error}}" class="entry-error" role="alert">
      <view class="entry-error-title">暂时无法进入日常记录</view>
      <view class="entry-error-detail">{{error}}</view>
    </view>
  </view>
</view>
