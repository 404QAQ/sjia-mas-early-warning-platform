@import './archive-common.wxss';

.page button.capture-card {
  display: block;
  margin-top: 28rpx;
  padding: 46rpx 24rpx;
  border: 3rpx dashed var(--mas-success);
  border-radius: var(--mas-radius-card);
  background: var(--mas-success-soft);
  color: var(--mas-primary-strong);
  text-align: center;
}

.capture-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  margin: 0 auto 22rpx;
  border-radius: 50%;
  background: var(--mas-surface);
  color: var(--mas-primary);
  font-size: 58rpx;
  font-weight: 300;
}

.page button.album-card {
  gap: 24rpx;
  justify-content: flex-start;
  margin-top: 24rpx;
  padding: 30rpx;
  border: 1rpx solid var(--mas-border);
  border-radius: var(--mas-radius-card);
  background: var(--mas-surface);
  box-shadow: var(--mas-shadow-card);
  color: var(--mas-text);
  text-align: left;
}

.album-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 86rpx;
  height: 86rpx;
  flex: none;
  border-radius: var(--mas-radius-control);
  background: var(--mas-surface-soft);
  color: var(--mas-primary);
  font-size: 46rpx;
}

.album-card > view:nth-child(2) {
  flex: 1;
  min-width: 0;
}

.arrow {
  color: var(--mas-text-subtle);
  font-size: 38rpx;
}

.page button.manual-button {
  margin: 12rpx auto 0;
}

.card .field:first-child {
  margin-top: 0;
}

.line-gap {
  margin-top: 16rpx;
}

.saved-card {
  padding: 52rpx 30rpx;
  text-align: center;
}

.saved-mark {
  width: 100rpx;
  height: 100rpx;
  margin: 0 auto 28rpx;
  border-radius: 50%;
  background: var(--mas-success-soft);
  color: var(--mas-success);
  font-size: 52rpx;
  line-height: 100rpx;
}

.saved-card .primary-button {
  margin-top: 36rpx;
}

.saved-card .text-button {
  margin: 12rpx auto 0;
}
