@import '../../styles/patient.wxss';

.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--mas-bg);
  color: var(--mas-text);
}

.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin: 4rpx 0 24rpx;
}

.header-main {
  flex: 1;
  min-width: 0;
}

.eyebrow {
  color: var(--mas-text-muted);
  font-size: 22rpx;
  line-height: 1.5;
}

.title {
  margin-top: 6rpx;
  color: var(--mas-text);
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.3;
  overflow-wrap: break-word;
}

.subtitle,
.report-time {
  margin-top: 8rpx;
  color: var(--mas-text-muted);
  font-size: 23rpx;
  line-height: 1.5;
}

.risk-hero {
  padding: 26rpx;
  border: 1rpx solid var(--mas-border);
  border-left: 6rpx solid var(--mas-text-subtle);
  border-radius: var(--mas-radius-card);
  background: var(--mas-surface);
  box-shadow: var(--mas-shadow-card);
}

.risk-urgent {
  border-left-color: var(--mas-danger);
}

.risk-watch {
  border-left-color: var(--mas-warning);
}

.risk-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.risk-kicker {
  color: var(--mas-text-muted);
  font-size: 23rpx;
}

.risk-label {
  max-width: 65%;
  padding: 5rpx 12rpx;
  border-radius: var(--mas-radius-control);
  color: var(--mas-text-muted);
  background: var(--mas-surface-soft);
  font-size: 21rpx;
  line-height: 1.4;
  text-align: right;
}

.risk-urgent .risk-label {
  color: var(--mas-danger);
  background: var(--mas-danger-soft);
}

.risk-watch .risk-label {
  color: var(--mas-warning);
  background: var(--mas-warning-soft);
}

.risk-title {
  margin-top: 14rpx;
  color: var(--mas-text);
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.4;
}

.risk-detail {
  margin-top: 10rpx;
  color: var(--mas-text-muted);
  font-size: 26rpx;
  line-height: 1.65;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 60rpx;
  margin: 24rpx 0 14rpx;
}

.section-heading > view:first-child {
  min-width: 0;
}

.section-title {
  color: var(--mas-text);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.4;
}

.section-caption {
  margin-top: 5rpx;
  color: var(--mas-text-muted);
  font-size: 23rpx;
  line-height: 1.5;
}

.data-card,
.symptom-card,
.med-card,
.visit-card {
  padding: 0 22rpx;
  border: 1rpx solid var(--mas-border);
  border-radius: var(--mas-radius-card);
  background: var(--mas-surface);
  box-shadow: var(--mas-shadow-card);
}

.series-row {
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--mas-border);
}

.series-row:last-child {
  border-bottom: 0;
}

.series-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
}

.series-name {
  flex: 1;
  min-width: 0;
  color: var(--mas-text);
  font-size: 26rpx;
  line-height: 1.5;
}

.series-latest {
  max-width: 65%;
  color: var(--mas-text);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.4;
  text-align: right;
  overflow-wrap: break-word;
}

.series-date,
.series-note {
  margin-top: 7rpx;
  color: var(--mas-text-muted);
  font-size: 22rpx;
  line-height: 1.55;
}

.series-change {
  color: var(--mas-text);
  font-weight: 600;
}

.data-footnote {
  margin: 10rpx 4rpx 0;
  color: var(--mas-text-muted);
  font-size: 21rpx;
  line-height: 1.55;
}

.narrative-block {
  padding: 20rpx 0;
}

.narrative-title {
  color: var(--mas-text);
  font-size: 24rpx;
  font-weight: 600;
}

.narrative-row {
  display: flex;
  align-items: flex-start;
  margin-top: 8rpx;
  color: var(--mas-text-muted);
  font-size: 23rpx;
  line-height: 1.6;
}

.narrative-bullet {
  flex: none;
  margin-right: 12rpx;
}

.empty-card,
.inline-notice {
  padding: 22rpx;
  border: 1rpx solid var(--mas-border);
  border-radius: var(--mas-radius-card);
  background: var(--mas-surface);
  color: var(--mas-text-muted);
  font-size: 24rpx;
  line-height: 1.65;
}

.unavailable-card {
  margin-top: 12rpx;
}

.inline-notice {
  margin-bottom: 12rpx;
  background: var(--mas-surface-soft);
}

.symptom-row {
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--mas-border);
}

.symptom-row:last-child {
  border-bottom: 0;
}

.symptom-name {
  color: var(--mas-text);
  font-size: 25rpx;
  line-height: 1.5;
}

.symptom-meta {
  margin-top: 6rpx;
  color: var(--mas-text-muted);
  font-size: 22rpx;
  line-height: 1.5;
}

.section-note {
  padding: 18rpx 0;
  color: var(--mas-text-muted);
  font-size: 23rpx;
  line-height: 1.6;
}

.med-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--mas-border);
}

.med-row:last-child {
  border-bottom: 0;
}

.med-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.med-name {
  flex: 1;
  min-width: 0;
  color: var(--mas-text);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.5;
}

.med-status {
  flex: none;
  padding: 4rpx 10rpx;
  border-radius: var(--mas-radius-control);
  background: var(--mas-surface-soft);
  color: var(--mas-text-muted);
  font-size: 21rpx;
  line-height: 1.5;
}

.med-detail {
  margin-top: 8rpx;
  color: var(--mas-text-muted);
  font-size: 24rpx;
  line-height: 1.55;
}

.med-source {
  margin-top: 8rpx;
  color: var(--mas-primary);
  font-size: 22rpx;
  line-height: 1.5;
}

.record-count {
  max-width: 50%;
  color: var(--mas-text-muted);
  font-size: 22rpx;
  line-height: 1.5;
  text-align: right;
}

.visit-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--mas-border);
}

.visit-main {
  flex: 1;
  min-width: 0;
}

.visit-title {
  color: var(--mas-text);
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.5;
}

.visit-copy {
  margin-top: 6rpx;
  color: var(--mas-text-muted);
  font-size: 23rpx;
  line-height: 1.6;
}

.visit-preparation {
  padding: 22rpx 0;
}

.report-footer {
  margin: 20rpx 4rpx 0;
  padding-bottom: 8rpx;
  color: var(--mas-text-muted);
  font-size: 22rpx;
  line-height: 1.65;
  text-align: center;
}

.page button {
  box-sizing: border-box;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  line-height: 1.5;
}

.page button::after {
  border: 0;
}

.page button.mini-link {
  width: auto;
  flex: none;
  min-height: var(--mas-control-height);
  margin: 0;
  padding: 0 8rpx;
  border: 0;
  border-radius: var(--mas-radius-control);
  color: var(--mas-primary);
  background: transparent;
  font-size: 23rpx;
}

.page button.row-button {
  width: auto;
  min-width: 112rpx;
  min-height: var(--mas-control-height);
  flex: none;
  margin: 0;
  padding: 10rpx 18rpx;
  border: 1rpx solid var(--mas-border);
  border-radius: var(--mas-radius-control);
  color: var(--mas-primary);
  background: var(--mas-surface-soft);
}

.page button.primary-button,
.page button.action-button,
.page button.outline-button {
  width: 100%;
  margin: 18rpx 0 0;
  padding: 16rpx 20rpx;
  border-radius: var(--mas-radius-control);
}

.page button.primary-button {
  border: 1rpx solid var(--mas-primary);
  background: var(--mas-primary);
  color: var(--mas-on-primary);
  font-weight: 600;
}

.page button.urgent-button {
  border: 1rpx solid var(--mas-danger);
  background: var(--mas-danger);
  color: var(--mas-on-primary);
  font-weight: 600;
}

.page button.watch-button {
  border: 1rpx solid var(--mas-warning);
  background: var(--mas-warning-soft);
  color: var(--mas-warning);
}

.page button.outline-button {
  border: 1rpx solid var(--mas-border);
  background: var(--mas-surface);
  color: var(--mas-primary);
}

.page button[disabled] {
  opacity: .55;
}

.state-card {
  padding: 28rpx 24rpx;
  border: 1rpx solid var(--mas-border);
  border-radius: var(--mas-radius-card);
  background: var(--mas-surface);
  box-shadow: var(--mas-shadow-card);
}

.state-title {
  color: var(--mas-text);
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.4;
}

.state-copy {
  margin-top: 10rpx;
  color: var(--mas-text-muted);
  font-size: 24rpx;
  line-height: 1.65;
}

.error-card {
  border-color: var(--mas-warning);
}

.refresh-note {
  margin-bottom: 14rpx;
  color: var(--mas-text-muted);
  font-size: 23rpx;
  line-height: 1.6;
}
