@import "../../styles/patient.wxss";

.intro { margin-bottom: 24rpx; color: var(--mas-text); font-size: 28rpx; font-weight: 600; }
.vitals-card { padding: var(--mas-card-padding); }
.label { margin: 24rpx 0 12rpx; color: var(--mas-text); font-size: 28rpx; font-weight: 600; }
.label:first-child { margin-top: 0; }
.label text { color: var(--mas-text-subtle); font-size: 24rpx; font-weight: 400; }
input { height: var(--mas-control-height); padding: 0 20rpx; background: var(--mas-surface); }
.pressure { display: flex; align-items: center; gap: 14rpx; }
.pressure input { flex: 1; width: 0; }
.page > .hint { margin-top: 24rpx; line-height: 1.6; }
.page button { min-height: var(--mas-control-height); margin-top: 24rpx; border-radius: var(--mas-radius-control); font-size: 28rpx; }
.primary { color: var(--mas-on-primary); background: var(--mas-primary); }
.secondary { color: var(--mas-primary); background: var(--mas-surface); }
.sample { color: var(--mas-text-muted); background: transparent; border: 1rpx solid transparent; }
.error, .message { padding: 20rpx; margin-top: 20rpx; font-size: 26rpx; line-height: 1.5; border-radius: var(--mas-radius-control); }
.vital-history { padding: 22rpx 0; font-size: 26rpx; line-height: 1.7; border-bottom: 1rpx solid var(--mas-border-soft); }
.vital-history:last-child { border-bottom: 0; }
