@import "../../styles/patient.wxss";
@import "./safety-common.wxss";

.handover-hero { margin: var(--mas-section-gap) 0; padding: 28rpx; color: var(--mas-on-primary); background: var(--mas-primary-strong); border-radius: var(--mas-radius-card); box-shadow: var(--mas-shadow-card); }
.hero-kicker, .readiness-label { color: rgba(255,255,255,.76); font-size: 23rpx; }
.hero-title { margin-top: 10rpx; font-size: 36rpx; font-weight: 700; line-height: 1.3; }
.hero-copy { margin-top: 12rpx; color: rgba(255,255,255,.86); font-size: 25rpx; line-height: 1.6; }
.readiness-row { display: flex; align-items: center; gap: 20rpx; margin-top: 24rpx; }
.readiness-value { margin-top: 2rpx; font-size: 34rpx; font-weight: 700; }
.readiness-track { flex: 1; height: 12rpx; overflow: hidden; border-radius: 999rpx; background: rgba(255,255,255,.24); }
.readiness-fill { height: 100%; border-radius: inherit; background: var(--mas-accent); }
.privacy-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.strong { color: var(--mas-text-strong); font-weight: 700; }
.privacy-state { margin-top: 18rpx; padding: 14rpx; color: var(--mas-primary); background: var(--mas-surface-soft); border-radius: var(--mas-radius-small); font-size: 24rpx; }
.section-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; }
.section-head .hint { margin: 0; font-size: 24rpx; }
.readiness-item { display: flex; align-items: center; gap: 14rpx; min-height: var(--mas-control-height); box-sizing: border-box; padding: 18rpx 0; border-bottom: 1rpx solid var(--mas-border-soft); }
.readiness-item:last-of-type { border-bottom: 0; }
.readiness-check { display: flex; align-items: center; justify-content: center; width: 36rpx; height: 36rpx; border: 2rpx solid var(--mas-border); border-radius: 50%; color: var(--mas-on-primary); font-size: 24rpx; }
.readiness-check.done { border-color: var(--mas-primary); background: var(--mas-primary); }
.readiness-text { flex: 1; color: var(--mas-text); font-size: 27rpx; }
.takeover-state { margin-top: 14rpx; padding: 14rpx; color: var(--mas-text-muted); background: var(--mas-surface-soft); border-radius: var(--mas-radius-small); font-size: 24rpx; }
.readiness-item.is-saving { opacity: .6; }
