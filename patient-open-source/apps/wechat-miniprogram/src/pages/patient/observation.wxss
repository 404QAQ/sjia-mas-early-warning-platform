@import "../../styles/patient.wxss";

page { background: var(--mas-bg); }
.page { min-height: 100vh; box-sizing: border-box; background: var(--mas-bg); color: var(--mas-text); }
.title { font-size: 36rpx; font-weight: 700; line-height: 1.35; }
.page-subtitle { margin-top: 0; color: var(--mas-text-muted); font-size: 24rpx; line-height: 1.55; }
.hint { color: var(--mas-text-muted); font-size: 24rpx; line-height: 1.6; }
.meta, .loading-line { color: var(--mas-text-subtle); font-size: 21rpx; line-height: 1.5; }
.loading-line { margin-top: 16rpx; }
.card { box-sizing: border-box; margin-top: 18rpx; padding: 24rpx; background: var(--mas-surface); border: 1rpx solid var(--mas-border); border-radius: var(--mas-radius-card); box-shadow: var(--mas-shadow-card); }
.card-heading { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.card-title { color: var(--mas-text); font-size: 29rpx; font-weight: 700; line-height: 1.4; }
.page button.text-button { width: auto; flex: none; white-space: nowrap; display: flex; align-items: center; justify-content: center; min-height: var(--mas-control-height); min-width: auto; margin: 0; padding: 0; color: var(--mas-primary); background: transparent; border: 0; border-radius: 0; font-size: 23rpx; line-height: 1.5; }
button::after { border: 0; }
.page button.primary, .page button.secondary { min-height: var(--mas-control-height); margin-top: 20rpx; border-radius: var(--mas-radius-control); font-size: 26rpx; }
.page button.primary { color: var(--mas-on-primary); background: var(--mas-primary); }
.page button.secondary { color: var(--mas-primary); background: var(--mas-surface-soft); border: 1rpx solid var(--mas-border); }
.page button[disabled] { color: var(--mas-text-subtle); background: var(--mas-bg); border-color: var(--mas-border); }
.empty-state { padding: 24rpx 0 8rpx; }
.empty-title { margin-bottom: 6rpx; color: var(--mas-text-muted); font-size: 26rpx; }
.record-row { padding: 20rpx 0; border-bottom: 1rpx solid var(--mas-border); }
.record-row:last-child { padding-bottom: 0; border-bottom: 0; }
.record-heading { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; }
.record-main { flex: 1; min-width: 0; color: var(--mas-text); font-size: 27rpx; font-weight: 600; }
.record-value { color: var(--mas-primary); font-size: 27rpx; font-weight: 700; }
.record-dose { color: var(--mas-text-muted); font-size: 23rpx; font-weight: 400; }
.record-meta { margin-top: 7rpx; color: var(--mas-text-muted); font-size: 22rpx; line-height: 1.5; }
.status-tag { padding: 5rpx 11rpx; color: var(--mas-text-muted); background: var(--mas-bg); border-radius: 999rpx; font-size: 21rpx; white-space: nowrap; }
.status-success { color: var(--mas-success); background: var(--mas-success-soft); }
.status-warning { color: var(--mas-warning); background: var(--mas-warning-soft); }
.followup-card { border-left: 0; }
.followup-date { margin: 16rpx 0 6rpx; color: var(--mas-text); font-size: 30rpx; font-weight: 600; }
.assessment-entry-card { border-left: 0; }
.assessment-last { margin: 12rpx 0 8rpx; color: var(--mas-text-subtle); font-size: 22rpx; }
.feeling-card .hint { margin-top: 10rpx; }
.stage-kicker { margin-bottom: 8rpx; color: var(--mas-text-muted); font-size: 22rpx; line-height: 1.5; }
.field-label { color: var(--mas-text); font-size: 25rpx; font-weight: 600; }
.temperature-entry { margin-top: 20rpx; padding: 20rpx; background: var(--mas-bg); border-radius: var(--mas-radius-control); }
.temperature-control { display: flex; align-items: center; gap: 12rpx; margin-top: 12rpx; }
.temperature { flex: 1; box-sizing: border-box; min-width: 0; width: 0; height: 88rpx; color: var(--mas-text); font-size: 52rpx; font-weight: 700; line-height: 1.2; }
.temperature-placeholder { color: var(--mas-text-subtle); font-size: 36rpx; font-weight: 400; }
.temperature-unit { flex: none; color: var(--mas-text-muted); font-size: 32rpx; }
.temperature-range { margin-top: 8rpx; color: var(--mas-text-muted); font-size: 22rpx; line-height: 1.5; }
.previous-reading { display: flex; flex-wrap: wrap; gap: 4rpx 12rpx; margin-top: 12rpx; color: var(--mas-text-muted); font-size: 22rpx; line-height: 1.6; }
.previous-reading text { color: var(--mas-text-subtle); }
.date-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; min-height: 88rpx; margin-top: 12rpx; border-bottom: 1rpx solid var(--mas-border); }
.date-row picker { flex: 1; min-width: 0; }
.date-picker { display: flex; align-items: center; justify-content: flex-end; gap: 16rpx; min-height: 88rpx; color: var(--mas-text); font-size: 25rpx; }
.date-picker text { color: var(--mas-primary); font-size: 23rpx; }
.symptoms-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; padding-top: 16rpx; }
.symptoms-copy { flex: 1; min-width: 0; }
.symptoms-copy .field-label { min-height: 44rpx; line-height: 44rpx; }
.symptoms-copy .field-label text { margin-left: 8rpx; color: var(--mas-text-subtle); font-size: 22rpx; font-weight: 400; }
.symptom-summary { margin-top: 2rpx; color: var(--mas-text-muted); font-size: 23rpx; line-height: 1.6; overflow-wrap: break-word; }
.symptom-summary.has-selection { color: var(--mas-text); }
.symptoms-panel { margin-top: 8rpx; padding-top: 2rpx; border-top: 1rpx solid var(--mas-border); }
.symptom-group-title { margin: 18rpx 0 8rpx; color: var(--mas-text-muted); font-size: 24rpx; font-weight: 600; }
.symptom { display: flex; align-items: flex-start; box-sizing: border-box; min-height: var(--mas-control-height); padding: 8rpx 0; color: var(--mas-text); font-size: 26rpx; }
.symptom checkbox { margin: 2rpx 14rpx 0 0; flex-shrink: 0; }
.symptom-label-wrap { flex: 1; min-width: 0; }
.symptom-note { display: block; margin-top: 5rpx; color: var(--mas-warning); font-size: 22rpx; line-height: 1.5; }
.form-intro { margin: 8rpx 0 0; }
.save-hint { margin-top: 12rpx; color: var(--mas-text-subtle); font-size: 21rpx; line-height: 1.5; text-align: center; }
.page button.history-toggle { width: 100%; margin-top: 8rpx; }
.error, .message { margin-top: 18rpx; padding: 18rpx 20rpx; border-radius: var(--mas-radius-control); font-size: 25rpx; line-height: 1.6; }
.error { color: var(--mas-danger); background: var(--mas-danger-soft); border: 1rpx solid var(--mas-danger); }
.message { color: var(--mas-success); background: var(--mas-success-soft); border: 1rpx solid var(--mas-border); }
.decision-title { color: var(--mas-danger); font-size: 28rpx; font-weight: 700; }
.trend-card .hint { margin-top: 8rpx; }
.trend-card { border-left: 5rpx solid var(--mas-danger); background: var(--mas-danger-soft); }
.queue-text { margin-top: 10rpx; color: var(--mas-text-muted); font-size: 25rpx; }
.page button.recovery-button { width: 100%; min-height: var(--mas-control-height); margin: 16rpx 0 0; }
@media (max-width: 350px) {
  .card { padding: 20rpx; }
  .card-heading { flex-wrap: wrap; }
  .record-heading { align-items: flex-start; }
  .record-value { white-space: nowrap; }
}

/* 参考健康中心：统一页面留白、卡片边界和数据层级。 */
/* 页面留白由 patient.wxss 的 .page.patient-page 统一提供。 */
.page-subtitle {
  margin: 4rpx 2rpx 8rpx;
  color: var(--mas-text-muted);
  font-size: 25rpx;
  line-height: 1.55;
}

.card {
  margin-top: 20rpx;
  padding: 26rpx;
  border-radius: var(--mas-radius-card);
  box-shadow: var(--mas-shadow-card);
}

.card-title { font-size: 30rpx; }
.hint { font-size: 25rpx; line-height: 1.65; }
.meta, .loading-line { font-size: 22rpx; }

.form-card {
  border-color: #d5e1e5;
}

.temperature-entry {
  margin-top: 22rpx;
  padding: 22rpx;
  border: 1rpx solid var(--mas-border);
  background: var(--mas-surface-soft);
  border-radius: var(--mas-radius-control);
}

.record-row { padding: 20rpx 0; }
.record-meta { font-size: 23rpx; }

.trend-card {
  border-left-width: 6rpx;
  background: var(--mas-danger-soft);
}

.page button.primary,
.page button.secondary {
  border-radius: var(--mas-radius-control);
}

@media (max-width: 350px) {
  .card { padding: 22rpx; }
}

.temperature-range { display: flex; justify-content: space-between; gap: 12rpx; font-size: 21rpx; }.temperature-range text { text-align: center; }.observation-extra { margin-top: 26rpx; padding-top: 24rpx; border-top: 1rpx solid var(--mas-bg); }.feeling-options { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 16rpx 0 26rpx; }.page .feeling-option { padding: 12rpx 16rpx; min-height: 88rpx; margin: 0; font-size: 23rpx; border: 1rpx solid var(--mas-border); background: var(--mas-surface); border-radius: var(--mas-radius-control); color: var(--mas-text-muted); }.page .feeling-option.selected { background: var(--mas-success-soft); color: var(--mas-primary); border-color: #71b6a9; }.observation-note { width: 100%; min-height: 170rpx; padding: 20rpx; box-sizing: border-box; background: var(--mas-bg); border: 1rpx solid var(--mas-border); border-radius: var(--mas-radius-control); font-size: 26rpx; line-height: 1.65; }.record-note { white-space: pre-wrap; font-size: 24rpx; color: var(--mas-text-muted); margin-top: 12rpx; line-height: 1.6; }
