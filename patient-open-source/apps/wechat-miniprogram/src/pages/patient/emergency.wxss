@import "../../styles/patient.wxss";
@import "./safety-common.wxss";

.page-heading { display: flex; justify-content: space-between; align-items: center; margin: 4rpx 0 22rpx; }.page-heading .title { margin-bottom: 0; }.eyebrow { margin-bottom: 7rpx; color: var(--mas-primary); font-size: 22rpx; letter-spacing: 1rpx; }.page-mark { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; border: 1rpx solid #d1e1e4; border-radius: 16rpx; color: #547683; background: var(--mas-surface); font-size: 39rpx; font-weight: 500; }.loading-hint { margin-bottom: 16rpx; }
.emergency-summary { margin: 22rpx 0 0; padding: 28rpx; border: 1rpx solid #173c58; border-radius: 18rpx; color: var(--mas-on-primary); background: #173a55; }
.summary-topline { display: flex; align-items: center; justify-content: space-between; }.summary-kicker { color: #adbfcc; font-size: 23rpx; }.summary-status { padding: 5rpx 12rpx; border: 1rpx solid #526d80; border-radius: 8rpx; color: #dce8ec; font-size: 21rpx; }.summary-title { margin-top: 10rpx; font-size: 39rpx; font-weight: 700; line-height: 1.35; }.summary-copy { margin-top: 8rpx; color: #beced9; font-size: 25rpx; line-height: 1.65; }.summary-label { color: #b4c6d2; font-size: 22rpx; }
.triage-summary { margin-top: 26rpx; padding: 21rpx 22rpx; border-left: 4rpx solid #69abb3; background: #23465f; }.triage-script { margin-top: 9rpx; font-size: 27rpx; line-height: 1.75; }.summary-destination { margin-top: 24rpx; }.summary-destination-name { margin-top: 6rpx; font-size: 29rpx; font-weight: 600; }.summary-destination-detail { margin-top: 6rpx; color: #c1d0da; font-size: 24rpx; line-height: 1.6; }.summary-metrics { display: flex; margin-top: 25rpx; padding: 20rpx 0 3rpx; border-top: 1rpx solid #36576d; }.summary-metric { flex: 1; min-width: 0; padding: 0 8rpx; text-align: center; border-right: 1rpx solid #36576d; }.summary-metric:last-child { border-right: 0; }.summary-metric-value { color: #e8f1f5; font-size: 25rpx; font-weight: 600; line-height: 1.4; }.summary-metric-label { margin-top: 7rpx; color: #9fb6c4; font-size: 21rpx; }.summary-updated { margin-top: 22rpx; color: #94acbe; font-size: 20rpx; text-align: right; }
.export-card { margin: 18rpx 0 26rpx; padding: 25rpx; border: 1rpx solid var(--mas-border); border-radius: var(--mas-radius-card); background: var(--mas-surface); }.export-heading, .card-heading { display: flex; align-items: center; justify-content: space-between; }.export-heading .card-title, .card-heading .card-title { margin-bottom: 8rpx; }.pdf-tag { margin-bottom: 8rpx; padding: 5rpx 10rpx; border-radius: 7rpx; color: #567d85; background: #eef5f5; font-size: 20rpx; letter-spacing: 1rpx; }.export-actions { display: flex; gap: 14rpx; margin-top: 8rpx; }.page .export-actions button { flex: 1 1 0; width: 0; min-width: 0; margin-bottom: 6rpx; padding-left: 10rpx; padding-right: 10rpx; font-size: 24rpx; }.reprint-note { margin-top: 13rpx; padding: 13rpx 16rpx; border-radius: 10rpx; color: #917743; background: #fcf6e9; font-size: 24rpx; line-height: 1.6; }
.emergency-card .card-title { color: #a65655; }.threshold-row { display: flex; align-items: flex-start; padding: 11rpx 0; font-size: 26rpx; line-height: 1.65; color: #675158; }.threshold-dot { flex-shrink: 0; width: 9rpx; height: 9rpx; margin: 16rpx 17rpx 0 2rpx; border-radius: 50%; background: #bd7379; }.info-row { display: flex; gap: 24rpx; padding: 15rpx 0; border-bottom: 1rpx solid var(--mas-border-soft); font-size: 25rpx; line-height: 1.6; }.info-row:last-child { border-bottom: 0; }.info-label { flex-shrink: 0; width: 158rpx; color: #8a9ca4; }.info-value { flex: 1; color: #344f61; overflow-wrap: break-word; }.action-row { display: flex; gap: 14rpx; padding: 11rpx 0; color: #536e79; font-size: 26rpx; line-height: 1.65; }.action-icon { display: flex; flex-shrink: 0; align-items: center; justify-content: center; width: 31rpx; height: 31rpx; margin-top: 5rpx; border-radius: 50%; color: #438576; background: #edf7f2; font-size: 22rpx; }.avoid-card .action-icon { color: #a46969; background: #fcf0ef; }.avoid-card .card-title { color: #a05f61; }
.section-heading { margin: 30rpx 4rpx 12rpx; color: var(--mas-primary); font-size: 28rpx; font-weight: 700; }.small-status { margin-bottom: 8rpx; color: #6b9595; font-size: 22rpx; }.kit-progress { display: flex; align-items: baseline; gap: 14rpx; margin: 4rpx 0 8rpx; }.kit-progress-number { color: #266b75; font-size: 39rpx; font-weight: 700; }.kit-progress-number text { margin-left: 6rpx; color: #a1b1b8; font-size: 25rpx; font-weight: 400; }
.field-label { margin-top: 20rpx; font-size: 25rpx; font-weight: 600; color: #4d6874; }.section-title { margin-top: 20rpx; font-size: 25rpx; font-weight: 600; color: #4d6874; }.row { display: flex; gap: 16rpx; }.row input { flex: 1; min-width: 0; }.thresholds { margin-top: 16rpx; border-top: 1rpx solid #e7ecea; }.items { margin-top: 16rpx; border-top: 1rpx solid #e7ecea; }.item { display: flex; align-items: flex-start; gap: 12rpx; padding: 16rpx 0; border-bottom: 1rpx solid #e7ecea; font-size: 26rpx; line-height: 1.6; }.item:last-child { border-bottom: none; }.check { display: flex; align-items: center; gap: 10rpx; min-height: 88rpx; margin-top: 18rpx; color: var(--mas-text-muted); font-size: 25rpx; line-height: 1.6; }
.page button.disclosure { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 88rpx; box-sizing: border-box; margin: 0; padding: 10rpx 0; border: none; border-radius: 0; color: inherit; background: transparent; text-align: left; }.disclosure .card-title { margin-bottom: 6rpx; }.disclosure .hint { font-size: 23rpx; }.disclosure-arrow { flex-shrink: 0; margin-left: 20rpx; color: #6f929a; font-size: 31rpx; }.disclosure-body { margin-top: 20rpx; padding-top: 18rpx; border-top: 1rpx solid #e9eff1; }.share-row { padding: 13rpx 0; border-bottom: 1rpx solid var(--mas-border-soft); }.share-row:last-child { border-bottom: 0; }.page button.refresh-button { width: 100%; margin-top: 28rpx; border: 0; color: var(--mas-text-muted); background: transparent; font-size: 23rpx; }

.inline-check { display: inline-block; flex-shrink: 0; vertical-align: middle; }
.card-prerequisite { margin-top: 18rpx; padding-top: 18rpx; border-top: 1rpx solid #e9eff1; }
.kit-empty { margin-top: 8rpx; padding: 20rpx; border-radius: 12rpx; background: #f2f7f7; }
.kit-empty-title { margin-bottom: 8rpx; color: #375f68; font-size: 26rpx; font-weight: 600; line-height: 1.5; }
