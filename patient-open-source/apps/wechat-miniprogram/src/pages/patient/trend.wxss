@import "../../styles/patient.wxss";
.trend-header { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.trend-header .title { margin: 0; }.trend-header .hint { margin-top: 6rpx; }.page > .trend-header { margin-bottom: 24rpx; }.audience-note { margin-top: 8rpx; color: var(--mas-text-muted); font-size: 21rpx; line-height: 1.5; }
.page button.text-button { width: auto; min-height: 88rpx; margin: 0; padding: 0 12rpx; background: transparent; color: var(--mas-primary); border: 0; }
.latest { margin-top: 10rpx; color: var(--mas-text); font-size: 38rpx; font-weight: 700; }
.count { color: var(--mas-text-muted); font-size: 22rpx; }
.decision { border-left: 6rpx solid var(--mas-primary); }.decision-urgent { background: var(--mas-danger-soft); border-left-color: var(--mas-danger); }.decision-urgent .card-title { color: var(--mas-danger); }.decision-watch { background: var(--mas-warning-soft); border-left-color: var(--mas-warning); }
.chart-layout { display: flex; margin-top: 32rpx; }.chart-axis { flex: none; width: 62rpx; height: 180rpx; margin-top: -8rpx; display: flex; flex-direction: column; justify-content: space-between; color: var(--mas-text-muted); font-size: 20rpx; }
.chart { flex: 1; min-width: 0; display: flex; gap: 8rpx; background: repeating-linear-gradient(to bottom, transparent, transparent 84rpx, #e7edef 84rpx, #e7edef 85rpx); }.chart-column { flex: 1; min-width: 0; text-align: center; }.chart-track { height: 170rpx; display: flex; align-items: flex-end; justify-content: center; }.chart-bar { width: 30rpx; position: relative; border-radius: 5rpx 5rpx 0 0; background: #63b8a5; }.chart-value { position: absolute; bottom: calc(100% + 6rpx); left: 50%; transform: translateX(-50%); white-space: nowrap; font-size: 18rpx; color: var(--mas-text-muted); }.chart-label { padding-top: 10rpx; background: var(--mas-surface); font-size: 20rpx; color: var(--mas-text-muted); }
.page button.records-toggle { width: 100%; display: flex; align-items: center; justify-content: space-between; min-height: 88rpx; margin: 20rpx 0 -8rpx; padding: 12rpx 0; background: transparent; border: 0; border-top: 1rpx solid var(--mas-border); border-radius: 0; color: var(--mas-primary); font-size: 23rpx; }.records-toggle text { font-size: 30rpx; }.record-row { display: flex; justify-content: space-between; align-items: center; gap: 12rpx; padding: 16rpx 0; border-top: 1rpx solid var(--mas-border); color: var(--mas-text-muted); font-size: 24rpx; }.record-value { color: var(--mas-text); font-size: 26rpx; font-weight: 600; }.trend-foot { color: var(--mas-text-muted); font-size: 22rpx; line-height: 1.6; padding: 0 10rpx 20rpx; }
