@import "../../styles/patient.wxss";
@import "./safety-common.wxss";

.badge { margin-left: 12rpx; padding: 5rpx 12rpx; color: var(--mas-primary); background: var(--mas-surface-soft); border-radius: 999rpx; font-size: 22rpx; font-weight: 500; }
.legend { background: var(--mas-surface); }
.field-label { margin: 20rpx 0 10rpx; color: var(--mas-text); font-size: 27rpx; font-weight: 600; }
.option-group { display: block; }
.tier { display: flex; align-items: flex-start; padding: 12rpx 0; }
.tier-body { flex: 1; margin-left: 12rpx; }
.tier-head { color: var(--mas-text-strong); font-size: 28rpx; font-weight: 600; }
.check { display: flex; align-items: center; min-height: var(--mas-control-height); margin-top: 18rpx; line-height: 1.6; color: var(--mas-text-muted); }
.row { display: flex; gap: 16rpx; margin-top: 12rpx; }
.row input { flex: 1; width: auto; margin-top: 0; padding: 16rpx; background: var(--mas-surface); }
.contact { padding-bottom: 20rpx; }
.action-row { display: flex; align-items: stretch; gap: 16rpx; margin-top: 18rpx; }
.page .action-row button { flex: 1; width: 0; margin: 0; }
.page button.inline-action { display: block; width: 100%; margin: 18rpx 0 0; }
button.danger { color: var(--mas-on-primary); background: var(--mas-danger); }
.contact-heading { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.contact-name { color: var(--mas-text); font-size: 30rpx; font-weight: 600; }
.relation-badge { margin-left: 12rpx; padding: 5rpx 10rpx; color: var(--mas-text-muted); background: var(--mas-surface-soft); border-radius: var(--mas-radius-small); font-size: 21rpx; font-weight: 400; }
.status-badge { flex-shrink: 0; padding: 6rpx 12rpx; color: var(--mas-text-subtle); background: var(--mas-surface-soft); border-radius: var(--mas-radius-small); font-size: 21rpx; }
.status-badge.active { color: var(--mas-success); background: var(--mas-success-soft); }
.contact-meta { display: flex; align-items: center; gap: 16rpx; margin: 16rpx 0; color: var(--mas-text-subtle); font-size: 23rpx; }
.contact-meta .badge { margin-left: 0; color: var(--mas-text-muted); background: var(--mas-surface); border: 1rpx solid var(--mas-border); border-radius: var(--mas-radius-small); }
.legend .line { margin: 12rpx 0; }
.management-row { display: flex; justify-content: flex-end; gap: 20rpx; margin-top: 8rpx; }
.page button.text-action { width: auto; min-height: var(--mas-control-height); margin: 0; padding: 10rpx 8rpx; color: var(--mas-text-muted); background: transparent; font-size: 23rpx; }
.page button.remove-action { color: var(--mas-danger); }
.registration-priority { display: flex; gap: 36rpx; padding: 18rpx 0; color: var(--mas-text-muted); font-size: 26rpx; }
.registration-card { border-color: var(--mas-focus); }
.page .contact-actions { flex-wrap: wrap; gap: 12rpx; }
.page .contact-actions button { min-width: 170rpx; font-size: 24rpx; }
